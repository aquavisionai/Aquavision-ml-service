# Export these into the process environment; .env is not loaded automatically.
AQUAVISION_API_KEY=replace-with-a-random-secret
AQUAVISION_DEVICE=cpu
TORCH_NUM_THREADS=1
# 384 preserves the previous tile predictions. 192 lowers memory but changes tile context.
INFERENCE_TILE_SIZE=384
MAX_FILE_SIZE_MB=20
MAX_IMAGE_PIXELS=2073600
MAX_IMAGE_DIMENSION=4096
# Optional: exported weights instead of the original best.pt
# MODEL_PATH=/absolute/path/to/inference.pt
# Only set CORS_ORIGINS for an intentional browser client.
